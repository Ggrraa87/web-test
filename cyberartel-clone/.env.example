# Пример файла переменных окружения
# Скопируйте в .env и заполните своими значениями

# Nginx настройки
NGINX_HOST=localhost
NGINX_PORT=8080

# Безопасность
# Генерируйте сложные пароли: openssl rand -base64 32
SECRET_KEY=your-secret-key-here
API_KEY=your-api-key-here

# Email настройки (для форм обратной связи)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password-here

# Режим (development / production)
NODE_ENV=production

# ВАЖНО: Никогда не коммитьте файл .env в git!
# Добавьте .env в .gitignore
